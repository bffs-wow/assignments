GEMINI_API_KEY=your_gemini_api_key_here
# OpenCode Go key (https://opencode.ai/workspace/...) — provider "opencode-go".
# Used by the WCL Explorer (default) and any agent whose model specifier is opencode-go/...
OPENCODE_API_KEY=your_opencode_go_api_key_here
# Model routing — Flue model specifiers in <provider>/<model> form.
# Defaults point at the OpenCode Go gateway (deepseek-v4-flash is the cheapest
# model on the gateway with a 1M context). Override per run, e.g.
#   MODEL_GENERATE=google/gemini-2.5-flash node index.js ...
MODEL_GENERATE=opencode-go/deepseek-v4-flash
MODEL_EXPLORER=opencode-go/deepseek-v4-flash
# Community-pulls ranking band (average-guild kills, not top parses).
# e.g. "100-500" or "200-400"; unset/blank = top parses. Used by `community`/`run`.
# COMMUNITY_RANKS=100-500
WCL_CLIENT_ID=your_wcl_client_id_here
WCL_CLIENT_SECRET=your_wcl_client_secret_here
RAID_HELPER_API_KEY=your_raidhelper_token_here
# Integration-test only: a real RaidHelper event id to fetch the roster for.
# (npm run test:integration skips RaidHelper tests when this is unset.)
RAID_HELPER_EVENT_ID=
# Report / fight / encounter are passed as CLI args (see `node index.js --help`),
# not here. This only sets the default WCL instance host (MoP classic).
WCL_INSTANCE=classic
